# Anthropic API key for caption generation. Leave empty to use mock captions.
ANTHROPIC_API_KEY=

# Claude model used for caption generation
CLAUDE_MODEL=claude-sonnet-5

# Where uploads/outros/outputs and the SQLite DB are stored (default: ./data)
DATA_DIR=

# Number of parallel video processing workers
FFMPEG_WORKERS=2

# Set to 1 to force mock captions even when an API key is present
CAPTION_MOCK=
